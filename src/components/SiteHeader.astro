---
import { site } from "../site";

const { pathname } = Astro.url;
const links = [
  { label: "About", href: "/#about" },
  { label: "Projects", href: "/#projects" },
  { label: "Experience", href: "/#experience" },
  { label: "Blog", href: "/blog" },
];
---

<header lang="en">
  <div class="inner">
    <a class="logo" href="/"><span class="dot" aria-hidden="true"></span>{site.name}</a>
    <nav id="site-menu" popover aria-label="Main">
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.href === "/blog" && pathname.startsWith("/blog") ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <button type="button" class="icon-button theme-toggle" data-theme-toggle aria-label="Toggle colour theme">
      <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
    </button>
    <button type="button" class="icon-button menu-button" popovertarget="site-menu" aria-label="Open menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
  </div>
</header>

<style>
  header {
    border-bottom: var(--border-width) solid var(--border);
    background: var(--ground);
  }
  .inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-padding);
    min-height: 68px;
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .logo {
    margin-right: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-weight: 600;
    font-size: 17px;
    color: var(--ink);
    text-decoration: none;
  }
  .dot {
    width: 14px;
    height: 14px;
    border: var(--border-width) solid var(--ink);
    border-radius: 50%;
    background: var(--accent);
  }
  nav {
    font-size: 14px;
    font-weight: 500;
  }
  .icon-button.menu-button {
    display: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  .icon-button {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-s);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  /* Both icons are stacked; the inactive one is transparent, so the
     light/dark switch needs no JavaScript and no duplicated rules. */
  .icon-button svg {
    grid-area: 1 / 1;
  }
  .moon {
    color: light-dark(var(--ink), transparent);
  }
  .sun {
    color: light-dark(transparent, var(--ink));
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--accent-text);
  }

  /* From tablet width the menu is plain inline navigation, not a popover. */
  @media (min-width: 768px) {
    nav {
      display: flex;
      align-items: center;
      gap: 28px;
      position: static;
      inset: auto;
      width: auto;
      height: auto;
      margin: 0;
      padding: 0;
      border: 0;
      overflow: visible;
      background: transparent;
      color: inherit;
    }
  }

  /* Below tablet width: compact header, and the nav opens as a panel under it. */
  @media (max-width: 767px) {
    .inner {
      min-height: 60px;
      padding: 0 12px 0 20px;
      gap: 4px;
      flex-wrap: nowrap;
    }
    .icon-button.menu-button {
      display: grid;
    }
    .theme-toggle {
      border-color: transparent;
      background: transparent;
    }
    nav:popover-open {
      display: flex;
      flex-direction: column;
      position: fixed;
      inset: 60px 0 auto 0;
      width: 100%;
      height: auto;
      margin: 0;
      padding: 8px 20px 16px;
      border: 0;
      border-bottom: var(--border-width) solid var(--border);
      background: var(--ground);
      color: var(--ink);
      font-size: 16px;
    }
  }
</style>
