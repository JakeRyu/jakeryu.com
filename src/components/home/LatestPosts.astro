---
import { listEntries } from "../../lib/translations";
import HomeSection from "./HomeSection.astro";

const limit = 5;
const entries = (await listEntries()).slice(0, limit);
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

{
  entries.length > 0 && (
    <HomeSection id="writing" title="Writing" label="endpoint reference">
      <div class="rows">
      <a class="all" href="/blog/">All posts →</a>
      <ul class="list">
        {entries.map(({ post, languages }) => (
          <li data-post>
            <a href={`/blog/${post.id}/`}>
              <span class="request">
                <span class="badge">GET</span>
                <span class="path">/blog/{post.id}</span>
              </span>
              <span class="title" lang={post.data.language}>{post.data.title}</span>
              <span class="meta">
                {languages.join(" · ")} · <time datetime={isoDate(post.data.date)}>{isoDate(post.data.date)}</time>
              </span>
            </a>
          </li>
        ))}
      </ul>
      </div>
    </HomeSection>
  )
}

<style>
  /* Sits on the heading row, at the right of the section's h2. */
  .rows {
    position: relative;
  }
  .all {
    position: absolute;
    right: 0;
    top: -57px;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  .all:hover {
    color: var(--accent-text);
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  li {
    border-bottom: 1px solid var(--hairline);
  }
  li:last-child {
    border-bottom: 0;
  }
  li a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    padding: 20px 24px;
    color: var(--ink);
    text-decoration: none;
  }
  li a:hover .title {
    color: var(--accent-text);
  }
  .request {
    display: flex;
    align-items: center;
    gap: 24px;
    flex: 0 0 auto;
  }
  .badge {
    flex: 0 0 auto;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--get-bg);
    color: var(--get-fg);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
  }
  .path {
    width: 280px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .title {
    flex: 1 1 320px;
    font-size: 17px;
    font-weight: 600;
  }
  .meta {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 767px) {
    .all {
      top: -51px;
    }
    li a {
      display: block;
      padding: 16px 18px;
    }
    .request {
      gap: 8px;
    }
    .path {
      width: auto;
      font-size: 12px;
    }
    .title {
      display: block;
      margin-top: 8px;
      font-size: 16px;
      line-height: 1.4;
    }
    .meta {
      display: block;
      margin-top: 4px;
      font-size: 11px;
    }
  }
</style>
