---
import { getCollection } from "astro:content";
import HomeSection from "./HomeSection.astro";

// File names order the groups (e.g. 01-backend.yaml).
const groups = (await getCollection("skills")).sort((a, b) => a.id.localeCompare(b.id));
---

{
  groups.length > 0 && (
    <HomeSection id="skills" title="Skills" label="toolbox">
      <div class="grid">
        {groups.map(({ data }) => (
          <article>
            <h3>{data.group}</h3>
            <ul>
              {data.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </HomeSection>
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  article {
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: 12px;
    padding: 18px 20px;
  }
  h3 {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    color: var(--muted);
  }
  h3::before {
    content: "«";
  }
  h3::after {
    content: "»";
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  li {
    padding: 3px 10px;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--ground);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-strong);
  }
</style>
