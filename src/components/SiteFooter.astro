---
import { site } from "../site";

const links = [
  { label: "GitHub", href: site.social.github },
  { label: "X", href: site.social.x },
  { label: "Email", href: site.social.email },
];
---

<footer lang="en">
  <div class="inner">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span class="links">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </span>
  </div>
</footer>

<style>
  footer {
    border-top: var(--border-width) solid var(--border);
    background: var(--ground);
    font-size: 14px;
    color: var(--muted);
  }
  .inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 12px var(--page-padding);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
  }
  .links {
    display: flex;
    gap: 8px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 8px;
    color: var(--muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--ink);
  }
</style>
