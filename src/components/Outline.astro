---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const entries = Astro.props.headings.filter((heading) => heading.depth === 2);
---

{
  entries.length > 0 && (
    <nav aria-label="On this page" class="outline" lang="en">
      <details open>
        <summary>On this page</summary>
        <ul>
          {entries.map((heading) => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  )
}

<script>
  // Open on wide screens, collapsed on phones. Without JavaScript it stays open.
  document.addEventListener("astro:page-load", () => {
    const details = document.querySelector<HTMLDetailsElement>(".outline details");
    if (details) details.open = !matchMedia("(max-width: 767px)").matches;
  });
</script>

<style>
  .outline {
    padding-top: 8px;
    font-size: 14px;
    line-height: 1.6;
  }
  summary {
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    list-style: none;
    pointer-events: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 14px;
    border-left: var(--border-width) solid var(--dot);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  a {
    color: var(--muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
  }
  @media (max-width: 1023px) {
    .outline {
      padding-top: 0;
      border: 1px solid var(--hairline);
      border-radius: var(--radius-s);
      background: var(--surface);
    }
    summary {
      min-height: 44px;
      margin: 0;
      padding: 0 14px;
      display: flex;
      align-items: center;
      cursor: pointer;
      pointer-events: auto;
    }
    ul {
      padding: 0 14px 12px;
      border-left: 0;
      gap: 6px;
    }
    a {
      color: var(--ink);
      display: inline-block;
      min-height: 32px;
    }
  }
</style>
