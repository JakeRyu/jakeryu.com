---
import type { ListEntry } from "../lib/translations";

interface Props {
  entries: ListEntry[];
}

const { entries } = Astro.props;
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<ul class="list">
  {entries.map(({ post, languages }) => (
    <li data-entry data-languages={languages.join(" ")}>
      <a href={`/blog/${post.id}/`}>
        <span class="badge">GET</span>
        <span class="path">/blog/{post.id}</span>
        <span class="title" lang={post.data.language}>{post.data.title}</span>
        <span class="meta">{languages.join(" · ")} · <time datetime={isoDate(post.data.date)}>{isoDate(post.data.date)}</time></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  li {
    border-bottom: 1px solid var(--hairline);
  }
  li:last-child {
    border-bottom: 0;
  }
  li[hidden] {
    display: none;
  }
  a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    padding: 20px 24px;
    color: var(--ink);
    text-decoration: none;
  }
  a:hover .title {
    color: var(--accent-text);
  }
  .badge {
    flex: 0 0 auto;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--get-bg);
    color: var(--get-fg);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
  }
  .path {
    flex: 0 0 280px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .title {
    flex: 1 1 320px;
    font-size: 17px;
    font-weight: 600;
  }
  .meta {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 767px) {
    .path {
      flex-basis: 100%;
    }
  }
</style>
