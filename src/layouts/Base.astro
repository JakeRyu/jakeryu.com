---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import "@fontsource-variable/noto-sans-kr/wght.css";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../site";

interface Props {
  title?: string;
  lang?: "en" | "ko";
  // Path of the page's own Open Graph image; pages without one share the default.
  ogImage?: string;
}

const { title, lang = "en", ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.origin).href;
const image = new URL(ogImage ?? "/og-default.png", site.origin).href;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="head" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Applies a stored theme choice before first paint, and again after each page swap. -->
    <script is:inline>
      (function () {
        function applyStoredTheme() {
          try {
            var theme = localStorage.getItem("theme");
            if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
          } catch (e) {}
        }
        applyStoredTheme();
        document.addEventListener("astro:after-swap", applyStoredTheme);
      })();
    </script>
    <ClientRouter />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content={ogImage ? "article" : "website"} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <!-- Cloudflare Web Analytics: cookie-free. It watches history changes itself, so it needs no data-astro-rerun after view transitions. -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}></script>
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <script>
      // Delegated, so it keeps working after view-transition page swaps.
      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element) || !event.target.closest("[data-theme-toggle]")) return;
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
