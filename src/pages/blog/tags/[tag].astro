---
import Base from "../../../layouts/Base.astro";
import PostList from "../../../components/PostList.astro";
import { tagEntries } from "../../../lib/translations";

export async function getStaticPaths() {
  return (await tagEntries()).map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

const { tag } = Astro.props;
---

<Base title={`#${tag.label}`}>
  <div class="wrap">
    <h1>#{tag.label} <span class="sub">/ <a href="/blog/tags/">all tags</a></span></h1>
    <PostList entries={tag.entries} />
  </div>
</Base>

<style>
  .wrap {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 56px var(--page-padding) 104px;
  }
  h1 {
    margin: 0 0 20px;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .sub {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
  }
  @media (max-width: 767px) {
    .wrap {
      padding: 24px 16px 64px;
    }
  }
</style>
