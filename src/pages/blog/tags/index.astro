---
import Base from "../../../layouts/Base.astro";
import { tagEntries } from "../../../lib/translations";

const tags = await tagEntries();
---

<Base title="Tags">
  <div class="wrap">
    <h1>Tags <span class="sub">/ endpoint reference</span></h1>
    <ul class="list">
      {tags.map(({ slug, label, entries }) => (
        <li>
          <a href={`/blog/tags/${slug}/`}>
            <span class="badge">GET</span>
            <span class="path">/blog/tags/{slug}</span>
            <span class="title">#{label}</span>
            <span class="meta">{entries.length} {entries.length === 1 ? "post" : "posts"}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .wrap {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 56px var(--page-padding) 104px;
  }
  h1 {
    margin: 0 0 20px;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .sub {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  li {
    border-bottom: 1px solid var(--hairline);
  }
  li:last-child {
    border-bottom: 0;
  }
  a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    padding: 20px 24px;
    color: var(--ink);
    text-decoration: none;
  }
  a:hover .title {
    color: var(--accent-text);
  }
  .badge {
    flex: 0 0 auto;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--get-bg);
    color: var(--get-fg);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
  }
  .path {
    flex: 0 0 280px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .title {
    flex: 1 1 320px;
    font-size: 17px;
    font-weight: 600;
  }
  .meta {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 767px) {
    .wrap {
      padding: 24px 16px 64px;
    }
    .path {
      flex-basis: 100%;
    }
  }
</style>
