---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Callout from "../../components/Callout.astro";
import Outline from "../../components/Outline.astro";
import TranslationLink from "../../components/TranslationLink.astro";
import { tagSlug } from "../../lib/tags";
import RelatedPosts from "../../components/RelatedPosts.astro";
import { relatedTo, translationsOf } from "../../lib/translations";
import { site } from "../../site";

export async function getStaticPaths() {
  // Drafts show on the dev server only.
  const posts = (await getCollection("blog")).filter((post) => import.meta.env.DEV || !post.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, language, tags, translationKey } = post.data;
const translations = await translationsOf(post);
const related = await relatedTo(post);
---

<script>
  // Progressive enhancement: the buttons are hidden in the markup and shown
  // once this script has run, including after view-transition swaps. The click
  // is delegated so it survives those swaps too.
  document.addEventListener("astro:page-load", () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-code]")) button.hidden = false;
  });
  document.addEventListener("click", async (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>("[data-copy-code]") : null;
    const code = button?.closest(".code-block")?.querySelector("pre")?.textContent;
    if (!button || code == null) return;
    try {
      await navigator.clipboard.writeText(code);
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy"), 2000);
    } catch {}
  });
</script>

<Base title={title} description={description} lang={language} ogImage={`/og/${post.id}.png`}>
  {
    translations.map((translation) => (
      <link slot="head" rel="alternate" hreflang={translation.data.language} href={`${site.origin}/blog/${translation.id}/`} />
    ))
  }
  <div class="wrap">
    <article>
      <p class="endpoint" lang="en"><span class="badge">GET</span><span>/blog/{post.id}</span></p>
      <h1>{title}</h1>
      <dl lang="en">
        <div><dt>date</dt><dd><time datetime={date.toISOString().slice(0, 10)}>{date.toISOString().slice(0, 10)}</time></dd></div>
        <div><dt>lang</dt><dd>{language}</dd></div>
        {tags.length > 0 && <div><dt>tags</dt><dd>{tags.map((tag, i) => <>{i > 0 && ", "}<a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a></>)}</dd></div>}
      </dl>
      <div class="prose">
        <Content components={{ Callout }} />
      </div>
    </article>
    <aside>
      <TranslationLink {title} {language} {translationKey} {translations} />
      <RelatedPosts {related} />
      <Outline headings={headings} />
    </aside>
  </div>
</Base>

<style>
  .wrap {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 56px var(--page-padding) 104px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 40px;
    align-items: start;
  }
  article {
    min-width: 0;
    padding: 48px 52px 56px;
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-l);
    font-size: 17px;
    line-height: 1.85;
  }
  aside {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .endpoint {
    margin: 0 0 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
  }
  .badge {
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--get-bg);
    color: var(--get-fg);
    font-weight: 500;
  }
  h1 {
    margin: 0;
    font-size: 42px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  dl {
    margin: 24px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }
  dl div {
    display: flex;
    gap: 8px;
  }
  dd {
    margin: 0;
    color: var(--ink);
  }
  .prose {
    margin-top: 36px;
  }
  .prose :global(p) {
    margin: 0 0 24px;
  }
  .prose :global(h2) {
    margin: 52px 0 18px;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-s);
  }
  .prose :global(.table-scroll) {
    margin: 0 0 24px;
    overflow-x: auto;
    border: var(--border-width) solid var(--border);
    border-radius: 10px;
  }
  .prose :global(table) {
    min-width: 480px;
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.6;
  }
  .prose :global(th) {
    padding: 8px 12px;
    text-align: left;
    white-space: nowrap;
    background: var(--ground);
    border-bottom: var(--border-width) solid var(--border);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
  }
  .prose :global(td) {
    padding: 8px 12px;
    vertical-align: top;
    font-size: 13px;
    line-height: 1.5;
    border-bottom: 1px solid var(--hairline);
  }
  /* The last column usually holds the long text; without a floor the short columns
     squeeze it and every row grows very tall. A wider table scrolls inside its box. */
  .prose :global(td:last-child) {
    min-width: 20rem;
  }
  .prose :global(tr:last-child td) {
    border-bottom: 0;
  }
  .prose :global(:not(pre) > code) {
    padding: 1px 6px;
    background: var(--ground);
    border: 1px solid var(--hairline);
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.86em;
  }
  .prose :global(.code-block) {
    margin: 0 0 24px;
    border: var(--border-width) solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }
  .prose :global(.code-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 6px 0 16px;
    background: light-dark(#14202b, #26323d);
    color: #c9d1da;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
  }
  .prose :global(.code-header button) {
    min-height: 44px;
    padding: 0 12px;
    border: 0;
    background: transparent;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
  }
  .prose :global(.code-header button:hover) {
    text-decoration: underline;
  }
  .prose :global(.code-header button[hidden]) {
    display: none;
  }
  /* The Shiki themes arrive as --shiki-light / --shiki-dark variables; light-dark()
     picks one from the page's colour scheme, so the manual toggle is followed too. */
  .prose :global(pre.astro-code) {
    margin: 0;
    padding: 18px 20px;
    overflow-x: auto;
    background: light-dark(#f6f8fa, #0e151c);
    color: light-dark(var(--shiki-light), var(--shiki-dark));
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.7;
  }
  .prose :global(pre.astro-code span) {
    color: light-dark(var(--shiki-light), var(--shiki-dark));
  }
  /* Below 1024px the sidebar dissolves into the page flow: the outline (kept in
     the sidebar in the DOM, so there is one copy) goes above the article, the
     other cards stay below it. */
  @media (max-width: 1023px) {
    .wrap {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }
    aside {
      display: contents;
    }
    aside > :global(*) {
      order: 2;
    }
    aside > :global(.outline) {
      order: 0;
      margin-bottom: 24px;
    }
    article {
      order: 1;
      margin-bottom: 24px;
    }
  }
  @media (max-width: 767px) {
    .prose :global(pre.astro-code) {
      padding: 14px 16px;
      font-size: 13px;
    }
    .wrap {
      padding: 24px 16px 64px;
    }
    article {
      padding: 28px 20px 36px;
    }
    h1 {
      font-size: 32px;
    }
  }
</style>
