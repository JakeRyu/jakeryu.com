---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  // Drafts show on the dev server only.
  const posts = (await getCollection("blog")).filter((post) => import.meta.env.DEV || !post.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, language, tags } = post.data;
---

<Base title={title} lang={language}>
  <div class="wrap">
    <article>
      <p class="endpoint" lang="en"><span class="badge">GET</span><span>/blog/{post.id}</span></p>
      <h1>{title}</h1>
      <dl lang="en">
        <div><dt>date</dt><dd><time datetime={date.toISOString().slice(0, 10)}>{date.toISOString().slice(0, 10)}</time></dd></div>
        <div><dt>lang</dt><dd>{language}</dd></div>
        {tags.length > 0 && <div><dt>tags</dt><dd>{tags.join(", ")}</dd></div>}
      </dl>
      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</Base>

<style>
  .wrap {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 56px var(--page-padding) 104px;
  }
  article {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 52px 56px;
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-l);
    font-size: 17px;
    line-height: 1.85;
  }
  .endpoint {
    margin: 0 0 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
  }
  .badge {
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--get-bg);
    color: var(--get-fg);
    font-weight: 500;
  }
  h1 {
    margin: 0;
    font-size: 42px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  dl {
    margin: 24px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }
  dl div {
    display: flex;
    gap: 8px;
  }
  dd {
    margin: 0;
    color: var(--ink);
  }
  .prose {
    margin-top: 36px;
  }
  .prose :global(p) {
    margin: 0 0 24px;
  }
  .prose :global(h2) {
    margin: 52px 0 18px;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-s);
  }
  @media (max-width: 767px) {
    .wrap {
      padding: 24px 16px 64px;
    }
    article {
      padding: 28px 20px 36px;
    }
    h1 {
      font-size: 32px;
    }
  }
</style>
